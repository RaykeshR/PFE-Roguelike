import requests

API_URL = "http://127.0.0.1:8000"  # ton backend FastAPI
token = None  # variable globale pour stocker le JWT du joueur connecté


def register_user(username: str, email: str, password: str):
    """
    Inscrit un nouvel utilisateur via l'API FastAPI.
    """
    payload = {"username": username, "email": email, "password": password}
    try:
        response = requests.post(f"{API_URL}/register", json=payload)
        if response.status_code == 200:
            data = response.json()
            print(f"✅ Utilisateur créé : {data['user']['username']} ({data['user']['email']})")
            return data["user"]
        else:
            print(f"❌ Erreur : {response.json().get('detail', response.text)}")
            return None
    except Exception as e:
        print("⚠️ Erreur lors de l’inscription :", str(e))
        return None


def login_user(username: str, password: str):
    """
    Connecte un utilisateur via l'API et récupère le token JWT.
    """
    global token
    payload = {"username": username, "password": password}
    try:
        response = requests.post(f"{API_URL}/login", json=payload)
        if response.status_code == 200:
            data = response.json()
            token = data["token"]
            print(f"✅ Connexion réussie : {data['message']}")
            print(f"🔑 Token : {token[:20]}...")  # affichage partiel du token
            return token
        else:
            print(f"❌ Erreur : {response.json().get('detail', response.text)}")
            return None
    except Exception as e:
        print("⚠️ Erreur lors de la connexion :", str(e))
        return None


def start_game():
    """
    Lance une partie via l’API (authentifiée avec le token JWT).
    """
    global token
    if not token:
        print("❌ Vous devez d'abord vous connecter.")
        return

    headers = {"Authorization": f"Bearer {token}"}
    try:
        response = requests.post(f"{API_URL}/game/start", headers=headers)
        if response.status_code == 200:
            print(response.json()["message"])
        else:
            print(f"❌ Erreur : {response.json().get('detail', response.text)}")
    except Exception as e:
        print("⚠️ Erreur lors du démarrage de la partie :", str(e))
if __name__ == "__main__":
    # Exemple simple d'utilisation
    print("=== Test de l'authentification ===")

    username = input("Nom d'utilisateur : ")
    password = input("Mot de passe : ")

    # Connexion
    login_user(username, password)

    # Lancer le jeu
    start_game()
